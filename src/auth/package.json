{
  "name": "idp-auth-service",
  "version": "1.0.0",
  "description": "Standalone SSO and authentication service for IDP tenants",
  "private": true,
  "scripts": {
    "dev": "tsx watch server.ts",
    "build:web": "next build --webpack",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:web && npm run build:server",
    "start": "NODE_ENV=production node dist/server.js",
    "type-check": "tsc --noEmit",
    "migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "cookie-parser": "1.4.7",
    "dotenv": "16.6.1",
    "ejs": "3.1.10",
    "express": "4.22.1",
    "express-rate-limit": "7.5.1",
    "helmet": "8.1.0",
    "ioredis": "5.10.1",
    "next": "16.4.0",
    "pg": "8.18.0",
    "qrcode": "1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "5.5.0",
    "reflect-metadata": "0.2.2",
    "typeorm": "0.3.31"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/ejs": "3.1.5",
    "@types/express": "4.17.25",
    "@types/node": "22.19.11",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.4.20",
    "postcss": "8.5.29",
    "tailwindcss": "3.4.19",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlirezaDadrass/Idp.git"
  },
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "overrides": {
    "qs": "6.16.0",
    "uuid": "11.1.1",
    "serialize-javascript": "7.1.2",
    "postcss": "8.5.29",
    "postcss-selector-parser": "7.1.6"
  }
}
