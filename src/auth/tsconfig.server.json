{
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["es2021"],
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "sourceMap": true
  },
  "include": ["server.ts", "lib/**/*.ts", "routes/**/*.ts"],
  "exclude": ["node_modules", "dist", "pages", "components", "scripts", "lib/ui/**/*"]
}
