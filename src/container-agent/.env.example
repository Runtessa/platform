CONTAINER_MANAGER_HOST=0.0.0.0
CONTAINER_MANAGER_PORT=4070
CONTAINER_MANAGER_TOKEN=change-me
# Required for Podman too; point this at the socket path available inside the manager container/process.
CONTAINER_MANAGER_SOCKET=/var/run/docker.sock
CONTAINER_MANAGER_ENGINE_LABEL=docker

# TLS (required by default)
CONTAINER_MANAGER_TLS_REQUIRED=true
CONTAINER_MANAGER_TLS_ENABLED=true
CONTAINER_MANAGER_TLS_AUTO_SELF_SIGNED=true
CONTAINER_MANAGER_TLS_KEY_PATH=./certs/server.key
CONTAINER_MANAGER_TLS_CERT_PATH=./certs/server.crt
CONTAINER_MANAGER_TLS_CA_PATH=
CONTAINER_MANAGER_TLS_MUTUAL=false
CONTAINER_MANAGER_TLS_SELF_SIGNED_DAYS=825
CONTAINER_MANAGER_TLS_CN=localhost

# Built-in managed services
CONTAINER_MANAGER_CODEX_IMAGE=idp/codex-gateway:latest
CONTAINER_MANAGER_MONITORING_IMAGE=idp/monitoring:latest
CONTAINER_MANAGER_MONITORING_REDIS_URL=redis://host.docker.internal:6379
CONTAINER_MANAGER_MONITORING_INGEST_TOKEN=change-me
CONTAINER_MANAGER_WORKSPACE_HOST_PATH=/absolute/host/path/to/IdpCore
CONTAINER_MANAGER_MONITORING_TLS_REQUIRED=true
CONTAINER_MANAGER_MONITORING_TLS_ENABLED=true
CONTAINER_MANAGER_WORKSPACE_MOUNT_PATH=/srv/idp
CONTAINER_MANAGER_CODEX_DATA_VOLUME_PREFIX=idp-codex-gw-data
CONTAINER_MANAGER_MONITORING_DATA_VOLUME=idp-monitoring-data

# Redis orchestration (IDE -> Redis Pub/Sub -> container-agent)
CONTAINER_ORCHESTRATOR_ENABLED=true
CONTAINER_ORCHESTRATOR_AGENT_ID=default
CONTAINER_ORCHESTRATOR_REDIS_URL=redis://host.docker.internal:6379
CONTAINER_ORCHESTRATOR_REQUEST_CHANNEL_PREFIX=idp:orchestrator:requests:
CONTAINER_ORCHESTRATOR_HEARTBEAT_KEY_PREFIX=idp:orchestrator:agent:

# Optional: custom managed services (JSON array)
# CONTAINER_MANAGER_SERVICES_JSON=[{"key":"my-service","image":"repo/app:latest","containerName":"idp-my-service","containerPort":8080,"hostPort":8080,"protocol":"http","publicHost":"127.0.0.1","env":["NODE_ENV=production"],"binds":["/absolute/host/path/to/IdpCore:/workspace"]}]
