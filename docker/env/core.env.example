# Generated private configuration: npm run docker:init-env
# Replace example.com domains and image owners before use.
INSTANCE_NAME=idpcore-local
NODE_ENV=production
PORT=3005
DATABASE_URL=postgresql://postgres:replace_with_postgres_password@postgres:5432/idpcore
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASS=replace_with_postgres_password
DB_NAME=idpcore
ENCRYPTION_KEY=replace_with_encryption_key
TOKEN_SECRET=replace_with_token_secret
DB_LOGGING=false
CACHE_REDIS_URL=redis://redis:6379
REDIS_URL=redis://redis:6379
MONITORING_SERVER_URL=
MONITORING_SERVER_TOKEN=replace_with_monitoring_server_token
MONITORING_ENFORCE_TLS=false
AGENT_CONTAINER_MANAGER_URL=http://container-agent:4070
AGENT_CONTAINER_MANAGER_TOKEN=replace_with_container_manager_token
AGENT_CONTAINER_MANAGER_INSECURE_TLS=true
CORE_SSO_AUTH_BASE_URL=https://auth.example.com
CORE_ADMIN_TOKEN=replace_with_admin_token
CORE_ALLOWED_ORIGINS=https://auth.example.com,https://ide.example.com
CORE_TRUST_PROXY=false
CORE_SSO_SCOPE=openid profile email
CORE_ADAPTER_STAGE=dev
CORE_SSO_COOKIE_NAME=idp_tenant_session
CORE_SSO_COOKIE_SAME_SITE=lax
CORE_SSO_COOKIE_SECURE=true
CORE_SSO_SESSION_TTL_SEC=28800
