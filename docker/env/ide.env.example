# Generated private configuration: npm run docker:init-env
# Replace example.com domains and image owners before use.
DATABASE_URL=postgresql://postgres:replace_with_postgres_password@postgres:5432/idpnext
DB_NAME=idpnext
DB_TYPE=postgres
CORE_DATABASE_URL=postgresql://postgres:replace_with_postgres_password@postgres:5432/idpcore
CORE_DB_NAME=idpcore
CORE_DB_TYPE=postgres
CORE_DB_SYNC=true
DEV_TENANT_HOST=localhost
ADMIN_TOKEN=replace_with_admin_token
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_ide_admin_password
REDIS_URL=redis://redis:6379
ENCRYPTION_KEY=replace_with_encryption_key
AI_BASE_URL=
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
AI_ALLOW_CLIENT_CONFIG=false
AGENT_TYPE=codex
AGENT_CODEX_MODEL=
AGENT_CODEX_MODELS=
AGENT_CODEX_GATEWAY_URL=
AGENT_CODEX_GATEWAY_MODE=container
AGENT_CODEX_GATEWAY_ENGINE=docker
AGENT_CODEX_GATEWAY_IMAGE=ghcr.io/your-org/idpcore-codex-gateway:main
AGENT_CODEX_GATEWAY_CONTAINER_PREFIX=idp-codex-gw
AGENT_CODEX_GATEWAY_PORT_RANGE=4600-4899
AGENT_CODEX_GATEWAY_HOST=127.0.0.1
AGENT_CODEX_GATEWAY_AUTO_BUILD=false
AGENT_CODEX_GATEWAY_SEND_FULL_PROMPT=false
AGENT_CODEX_GATEWAY_MAX_PROMPT_CHARS=120000
AGENT_CODEX_GATEWAY_MAX_CONTEXT_CHARS=60000
AGENT_CODEX_GATEWAY_MAX_SUMMARY_CHARS=12000
AGENT_CODEX_GATEWAY_MAX_HISTORY_ITEMS=120
AGENT_CODEX_GATEWAY_RECENT_HISTORY_ITEMS=12
AGENT_CODEX_GATEWAY_HISTORY_ENTRY_CHARS=1800
AGENT_CONTAINER_MANAGER_URL=http://container-agent:4070
AGENT_CONTAINER_MANAGER_TOKEN=replace_with_container_manager_token
AGENT_CONTAINER_MANAGER_INSECURE_TLS=true
IDE_AUTH_SERVICE_URL=http://auth:3015
IDE_AUTH_SERVICE_TOKEN=replace_with_internal_api_token
CORE_SSO_AUTH_BASE_URL=https://auth.example.com
MONITORING_SERVER_URL=
MONITORING_INGEST_PROXY_URL=
MONITORING_INGEST_TOKEN=replace_with_monitoring_ingest_token
MONITORING_ENFORCE_TLS=false
