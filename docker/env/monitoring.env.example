# Generated private configuration: npm run docker:init-env
# Replace example.com domains and image owners before use.
MONITORING_HOST=0.0.0.0
MONITORING_PORT=3011
REDIS_URL=redis://redis:6379
MONITORING_INGEST_TOKEN=replace_with_monitoring_ingest_token
MONITORING_SERVER_TOKEN=replace_with_monitoring_server_token
MONITORING_TLS_REQUIRED=false
MONITORING_TLS_ENABLED=false
MONITORING_TLS_AUTO_SELF_SIGNED=false
MONITORING_TLS_KEY_PATH=/app/certs/server.key
MONITORING_TLS_CERT_PATH=/app/certs/server.crt
MONITORING_TLS_SELF_SIGNED_DAYS=825
MONITORING_TLS_CN=localhost
MONITORING_TLS_CA_PATH=
MONITORING_TLS_MUTUAL=false
MONITORING_INSTANCE_TTL_SEC=30
MONITORING_PAYLOAD_LIMIT=2mb
