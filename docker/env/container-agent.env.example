# Generated private configuration: npm run docker:init-env
# Replace example.com domains and image owners before use.
CONTAINER_MANAGER_HOST=0.0.0.0
CONTAINER_MANAGER_PORT=4070
CONTAINER_MANAGER_TOKEN=replace_with_container_manager_token
CONTAINER_MANAGER_SOCKET=/var/run/docker.sock
CONTAINER_MANAGER_ENGINE_LABEL=docker
CONTAINER_MANAGER_TLS_REQUIRED=false
CONTAINER_MANAGER_TLS_ENABLED=false
CONTAINER_MANAGER_TLS_AUTO_SELF_SIGNED=false
CONTAINER_MANAGER_TLS_KEY_PATH=/app/certs/server.key
CONTAINER_MANAGER_TLS_CERT_PATH=/app/certs/server.crt
CONTAINER_MANAGER_TLS_CA_PATH=
CONTAINER_MANAGER_TLS_MUTUAL=false
CONTAINER_MANAGER_TLS_SELF_SIGNED_DAYS=825
CONTAINER_MANAGER_TLS_CN=localhost
CONTAINER_MANAGER_CODEX_IMAGE=ghcr.io/your-org/idpcore-codex-gateway:main
CONTAINER_MANAGER_MONITORING_IMAGE=ghcr.io/your-org/idpcore-monitoring:main
CONTAINER_MANAGER_MONITORING_REDIS_URL=redis://redis:6379
CONTAINER_MANAGER_MONITORING_INGEST_TOKEN=replace_with_monitoring_ingest_token
CONTAINER_MANAGER_WORKSPACE_MOUNT_PATH=/srv/idp
CONTAINER_MANAGER_CODEX_DATA_VOLUME_PREFIX=idp-codex-gw-data
CONTAINER_MANAGER_MONITORING_DATA_VOLUME=idp-monitoring-data
