# Docker image-based stack. Set the registry to the owner of your published images.
IMAGE_TAG=main
IMAGE_REGISTRY=ghcr.io/your-org
CORE_IMAGE=${IMAGE_REGISTRY}/idpcore-core:${IMAGE_TAG}
AUTH_IMAGE=${IMAGE_REGISTRY}/idpcore-auth:${IMAGE_TAG}
IDE_IMAGE=${IMAGE_REGISTRY}/idpcore-ide:${IMAGE_TAG}
MONITORING_IMAGE=${IMAGE_REGISTRY}/idpcore-monitoring:${IMAGE_TAG}
CONTAINER_AGENT_IMAGE=${IMAGE_REGISTRY}/idpcore-container-agent:${IMAGE_TAG}
CODEX_GATEWAY_IMAGE=${IMAGE_REGISTRY}/idpcore-codex-gateway:${IMAGE_TAG}
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_postgres_password
POSTGRES_DB=postgres
PORT_CORE=3005
PORT_AUTH=3015
PORT_IDE=3002
PORT_MONITORING=3011
PORT_CONTAINER_AGENT=4070
PORT_CODEX_GATEWAY=4040
PORT_NGINX_HTTP=80
