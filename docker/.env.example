# Images appear after the first published GitHub Release. Pin its version for upgrades.
IMAGE_TAG=latest
IMAGE_REGISTRY=ghcr.io/runtessa
CORE_IMAGE=${IMAGE_REGISTRY}/runtime:${IMAGE_TAG}
AUTH_IMAGE=${IMAGE_REGISTRY}/auth:${IMAGE_TAG}
IDE_IMAGE=${IMAGE_REGISTRY}/studio:${IMAGE_TAG}
MONITORING_IMAGE=${IMAGE_REGISTRY}/monitoring:${IMAGE_TAG}
CONTAINER_AGENT_IMAGE=${IMAGE_REGISTRY}/container-agent:${IMAGE_TAG}
CODEX_GATEWAY_IMAGE=${IMAGE_REGISTRY}/assistant-gateway:${IMAGE_TAG}
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_postgres_password
POSTGRES_DB=postgres
PORT_CORE=3005
PORT_AUTH=3015
PORT_IDE=3002
PORT_MONITORING=3011
PORT_CONTAINER_AGENT=4070
PORT_CODEX_GATEWAY=4040
PORT_NGINX_HTTP=80
