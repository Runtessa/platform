{
  "name": "idpcore",
  "version": "0.1.0",
  "main": "dist/server.js",
  "workspaces": [
    "src/core",
    "src/ideNew",
    "src/ide-vscode",
    "src/packages/*"
  ],
  "scripts": {
    "build:shared": "tsc -p src/packages/shared/tsconfig.json",
    "build": "npm run build:shared && tsc",
    "build:front": "npm --prefix src/kernel run build",
    "docker:prepare": "node scripts/docker/prepare-apps.mjs",
    "docker:init-env": "node scripts/docker/init-env.mjs",
    "security:secrets": "node scripts/security/scan-secrets.mjs",
    "security:history": "node scripts/security/scan-history.mjs",
    "test:env-setup": "node --test scripts/docker/init-env.test.mjs",
    "test:logging": "node --test scripts/security/logging-*.test.cjs",
    "test:runtime": "npm run build:shared && npm --prefix src/core run build && node --test --test-concurrency=1 scripts/security/runtime-isolation.test.cjs scripts/security/runtime-models.test.cjs scripts/security/runtime-capabilities.test.cjs",
    "test:runtime:integration": "npm run build:shared && npm --prefix src/core run build && node scripts/security/runtime-postgres.test.cjs",
    "start": "npm run build && npm run build:front && node dist/server.js",
    "core:dev": "npm --prefix src/core run dev",
    "core:start": "npm --prefix src/core run start",
    "ide:dev": "npm --prefix src/ideNew run dev",
    "ide:start": "npm --prefix src/ideNew run start",
    "vscode:build": "npm --prefix src/ide-vscode run build",
    "vscode:type-check": "npm --prefix src/ide-vscode run type-check",
    "auth:dev": "npm --prefix src/auth run dev",
    "auth:start": "npm --prefix src/auth run start",
    "apps:dev": "concurrently -k -n core,ide,auth -c blue,green,magenta \"npm run core:dev\" \"npm run ide:dev\" \"npm run auth:dev\"",
    "monitoring:start": "npm --prefix src/monitoring run start",
    "monitoring:dev": "npm --prefix src/monitoring run dev",
    "container-agent:start": "npm --prefix src/container-agent run start",
    "container-agent:dev": "npm --prefix src/container-agent run dev",
    "docs:generate": "node docs/scripts/generate-advanced-docs.js",
    "docs:install": "npm --prefix docs/site install",
    "docs:start": "npm run docs:generate && npm --prefix docs/site run start",
    "docs:build": "npm run docs:generate && npm --prefix docs/site run build",
    "docs:serve": "npm --prefix docs/site run serve",
    "docs:clean": "npm --prefix docs/site run clear",
    "docker:pull": "docker compose -f docker/docker-compose.yml --env-file docker/.env pull",
    "docker:build": "docker compose -f docker/docker-compose.yml --env-file docker/.env build",
    "docker:build:local": "npm run docker:prepare && docker compose build",
    "docker:up:local": "docker compose up -d",
    "podman:build:local": "npm run docker:prepare && podman compose build",
    "podman:up:local": "podman compose up -d",
    "docker:up": "docker compose -f docker/docker-compose.yml --env-file docker/.env up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml --env-file docker/.env down",
    "docker:logs": "docker compose -f docker/docker-compose.yml --env-file docker/.env logs -f --tail=200",
    "seed": "ts-node src/core/seed.ts",
    "seed-packages": "ts-node src/core/seed-packages.ts",
    "dump": "node dump-project.js",
    "vscode:test": "npm --prefix src/ide-vscode run test",
    "vscode:host": "npm --prefix src/ide-vscode run dev:host"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
